# ---------------------------------------------------------------------------
# Open RAG - configuration
# Copiez ce fichier en ".env" et ajustez si besoin avant de lancer
# "docker compose up -d --build"
# ---------------------------------------------------------------------------

# Modele de discussion (doit supporter le "tool calling" n'est pas requis).
# Choisissez un modele adapte a votre machine :
#   - llama3.1:8b (bon compromis, ~5GB de VRAM/RAM)
#   - qwen2.5:7b-instruct
#   - qwen2.5:14b-instruct (plus precis, plus lourd)
OLLAMA_CHAT_MODEL=llama3.1:8b

# Modele multimodal (vision) utilise pour lire/decrire les images et les
# PDF scannes (sans texte extractible).
#   - llava:7b (leger, generaliste)
#   - qwen2.5vl:7b (meilleure lecture de documents/texte dans l'image)
OLLAMA_VISION_MODEL=llava:7b

# Modele d'embeddings utilise pour indexer les documents dans la base
# vectorielle. Reste toujours local, meme si Ollama Cloud est configure
# ci-dessous (l'API cloud n'a pas de route /api/embeddings).
OLLAMA_EMBED_MODEL=nomic-embed-text

# URL interne d'Ollama (ne pas changer si vous utilisez docker-compose.yml
# tel quel)
OLLAMA_BASE_URL=http://ollama:11434

# ---------------------------------------------------------------------------
# Ollama Cloud (optionnel) - https://ollama.com/models
# ---------------------------------------------------------------------------

# Si renseignee, le chat et la lecture d'images (vision) basculent
# automatiquement sur les modeles cloud ci-dessous pour des reponses plus
# reactives - les embeddings restent toujours locaux. Laissez vide pour
# rester 100% local.
OLLAMA_CLOUD_API_KEY=
OLLAMA_CLOUD_BASE_URL=https://ollama.com
OLLAMA_CLOUD_CHAT_MODEL=gpt-oss:20b
OLLAMA_CLOUD_VISION_MODEL=qwen3.5

# ---------------------------------------------------------------------------
# Mistral (optionnel, prepare mais pas encore branche - voir TODO.md)
# ---------------------------------------------------------------------------
MISTRAL_API_KEY=

# Moteur de recherche web local (SearXNG), utilise pour completer les
# reponses avec des informations issues du web.
SEARXNG_BASE_URL=http://searxng:8080

# Port expose sur la machine hote pour l'interface web
# (3000 en dev avec "docker compose up", 8080 par defaut en prod avec
# "docker compose -f docker-compose.prod.yml up")
FRONTEND_PORT=3000

# Port expose sur la machine hote pour l'API backend (utile pour debug)
BACKEND_PORT=8000

# Taille max d'un fichier uploade (Mo)
MAX_UPLOAD_MB=50

# ---------------------------------------------------------------------------
# Charge / stabilite (important sur un petit serveur, type VPS 2 vCPU)
# ---------------------------------------------------------------------------

# Nombre de requetes Ollama LOCAL (chat/embeddings/vision) executees en
# parallele. Laissez a 1 sur un serveur CPU sans beaucoup de RAM : toutes
# les requetes des utilisateurs sont alors mises en file d'attente et
# traitees une par une, ce qui evite de saturer la machine. N'augmentez que
# si Ollama a vraiment la RAM/le GPU pour faire tourner plusieurs inferences
# a la fois. Sans effet sur les appels Ollama Cloud, qui contournent cette
# file d'attente.
OLLAMA_MAX_CONCURRENCY=1

# ---------------------------------------------------------------------------
# Comptes et securite
# ---------------------------------------------------------------------------

# Cle secrete utilisee pour signer les sessions utilisateur et les liens de
# reinitialisation de mot de passe / confirmation newsletter. IMPORTANT en
# production : definissez une valeur fixe et aleatoire (ex: `openssl rand
# -hex 32`), sinon une cle temporaire est generee a chaque demarrage et tout
# le monde est deconnecte apres un redemarrage du backend.
SECRET_KEY=

# Duree de validite (en jours) d'une session utilisateur.
USER_TOKEN_TTL_DAYS=30

# Origines autorisees a appeler l'API (separees par des virgules), par
# exemple "https://mon-domaine.fr". "*" autorise tout le monde : pratique
# en developpement, a restreindre en production.
CORS_ORIGINS=*

# URL publique du frontend, utilisee pour construire les liens dans les
# emails (reinitialisation de mot de passe, confirmation newsletter).
FRONTEND_BASE_URL=http://localhost:3000

# Adresse affichee/utilisee comme contact (optionnel).
CONTACT_EMAIL=

# Difficulte du captcha "preuve de travail" auto-heberge (nombre de zeros
# hexa requis en tete du hash - 5 est un bon compromis UX/anti-bot).
CAPTCHA_DIFFICULTY=5

# ---------------------------------------------------------------------------
# Email sortant (SMTP)
# ---------------------------------------------------------------------------

# Laissez SMTP_HOST vide pour que les emails (reset mot de passe, newsletter)
# soient simplement journalises (docker logs open-rag-backend-1) au lieu
# d'etre envoyes - pratique pour tester sans vrai serveur SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=Open RAG <no-reply@open-rag.local>
