# ---------------------------------------------------------------------------
# Docverse - configuration
# Copiez ce fichier en ".env" et ajustez si besoin avant de lancer
# "docker compose up -d --build"
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# IA - Mistral AI (unique fournisseur)
# ---------------------------------------------------------------------------
# Toute l'inference (chat, vision, embeddings) passe par l'API Mistral,
# editeur francais, facturee a l'usage. Aucun modele n'est heberge sur le
# serveur : plus rien a telecharger, plus de GPU/RAM a prevoir.
#
# OBLIGATOIRE : sans cle, le chat et l'indexation de documents echouent.
# Creez-en une sur https://console.mistral.ai/
MISTRAL_API_KEY=

MISTRAL_BASE_URL=https://api.mistral.ai

# Modele de discussion. mistral-large-latest pour la qualite maximale,
# mistral-small-latest pour diviser le cout par ~8 a qualite honorable.
MISTRAL_CHAT_MODEL=mistral-large-latest

# Modele multimodal (vision) pour lire les images et les PDF scannes.
MISTRAL_VISION_MODEL=mistral-medium-latest

# Modele d'embeddings pour indexer les documents dans la base vectorielle.
# ATTENTION : changer ce modele change la dimension des vecteurs (1024 pour
# mistral-embed) et rend inexploitable un index existant - il faut alors
# vider la base vectorielle et reindexer tous les documents.
MISTRAL_EMBED_MODEL=mistral-embed

# ---------------------------------------------------------------------------
# Marque - permet de renommer le produit sans modifier le code
# ---------------------------------------------------------------------------
# Ces valeurs alimentent les emails, les meta/SEO, les mentions legales et
# l'interface. Pour renommer le produit, il suffit de les changer ici (et
# VITE_BRAND_* cote frontend, voir frontend/.env.example).
BRAND_NAME=Docverse
BRAND_DOMAIN=localhost
HOSTING_COUNTRY=France
HOSTING_PROVIDER=OVHcloud

# ---------------------------------------------------------------------------
# Connexion SSO (optionnel) - un fournisseur n'apparait sur les pages
# connexion/inscription que si son client id est renseigne.
# Google accepte http://localhost comme URI de redirection en dev ; Apple
# exige du HTTPS et n'est donc utilisable qu'avec un vrai nom de domaine
# (ou un tunnel HTTPS).
# ---------------------------------------------------------------------------
# En production (docker-compose.prod.yml + Caddy), utilisez votre vrai
# domaine : BACKEND_BASE_URL=https://votredomaine.com
BACKEND_BASE_URL=http://localhost:8000
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_PRIVATE_KEY=

# GitHub OAuth App (github.com/settings/developers) - callback to register:
# <BACKEND_BASE_URL>/api/auth/oauth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# LinkedIn app with the "Sign In with LinkedIn using OpenID Connect" product
# (linkedin.com/developers/apps) - requires an associated LinkedIn Company
# Page. Callback to register: <BACKEND_BASE_URL>/api/auth/oauth/linkedin/callback
LINKEDIN_OAUTH_CLIENT_ID=
LINKEDIN_OAUTH_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Limites d'utilisation par compte (le service est entierement gratuit) -
# voir FREE_QUOTAS dans backend/app/config.py. Valeurs par defaut :
# ---------------------------------------------------------------------------
# FREE_MAX_SPACES=3
# FREE_MAX_MEMBERS_PER_SPACE=5
# FREE_STORAGE_MB_PER_SPACE=500
# FREE_MESSAGES_PER_DAY=50

# Moteur de recherche web local (SearXNG), utilise pour completer les
# reponses avec des informations issues du web.
SEARXNG_BASE_URL=http://searxng:8080

# Port expose sur la machine hote pour l'interface web
# (3000 en dev avec "docker compose up", 8080 par defaut en prod avec
# "docker compose -f docker-compose.prod.yml up")
FRONTEND_PORT=3000

# Port expose sur la machine hote pour l'API backend (utile pour debug)
BACKEND_PORT=8000

# Taille max d'un fichier uploade (Mo)
MAX_UPLOAD_MB=50

# ---------------------------------------------------------------------------
# Charge / stabilite
# ---------------------------------------------------------------------------

# Nombre d'appels simultanes a l'API Mistral. L'inference n'est plus
# hebergee ici : cette limite ne protege plus le serveur, elle evite
# seulement de declencher les erreurs 429 (quota) du fournisseur. 8 est un
# bon point de depart ; baissez-la si vous voyez des 429 dans les logs.
LLM_MAX_CONCURRENCY=8

# ---------------------------------------------------------------------------
# Comptes et securite
# ---------------------------------------------------------------------------

# Cle secrete utilisee pour signer les sessions utilisateur et les liens de
# reinitialisation de mot de passe / confirmation newsletter. IMPORTANT en
# production : definissez une valeur fixe et aleatoire (ex: `openssl rand
# -hex 32`), sinon une cle temporaire est generee a chaque demarrage et tout
# le monde est deconnecte apres un redemarrage du backend.
SECRET_KEY=

# Duree de validite (en jours) d'une session utilisateur.
USER_TOKEN_TTL_DAYS=30

# Origines autorisees a appeler l'API (separees par des virgules), par
# exemple "https://votredomaine.com". "*" autorise tout le monde : pratique
# en developpement, a restreindre en production.
CORS_ORIGINS=*

# URL publique du frontend, utilisee pour construire les liens dans les
# emails (reinitialisation de mot de passe, confirmation newsletter).
# En production : https://votredomaine.com
FRONTEND_BASE_URL=http://localhost:3000


# Adresse affichee/utilisee comme contact (optionnel).
CONTACT_EMAIL=

# Ligne d'identite legale imprimee en bas des emails (editeur, numero
# d'immatriculation, adresse...) - optionnelle, omise si vide.
LEGAL_EMAIL_FOOTER=

# Difficulte du captcha "preuve de travail" auto-heberge (nombre de zeros
# hexa requis en tete du hash - 5 est un bon compromis UX/anti-bot).
CAPTCHA_DIFFICULTY=5

# ---------------------------------------------------------------------------
# Email sortant (SMTP)
# ---------------------------------------------------------------------------

# Laissez SMTP_HOST vide pour que les emails (reset mot de passe, newsletter)
# soient simplement journalises (docker logs docverse-backend-1) au lieu
# d'etre envoyes - pratique pour tester sans vrai serveur SMTP.
# SMTP_PORT=465 bascule automatiquement sur SSL implicite (SMTP_SSL) ;
# tout autre port utilise STARTTLS si SMTP_USE_TLS=true (587 typiquement).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=Docverse <no-reply@docverse.local>
