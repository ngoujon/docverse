# ---------------------------------------------------------------------------
# Frontend - variables de construction (Vite)
# Copiez ce fichier en "frontend/.env" pour surcharger en local.
# ---------------------------------------------------------------------------

# --- Marque ---------------------------------------------------------------
# Ces valeurs sont injectees a la construction et alimentent les titres de
# page, les meta et les textes traduits (via {{brand}}, {{domain}}...).
# Pour renommer le produit, changez-les ici ET les BRAND_* du .env racine
# (backend). Aucun autre fichier n'est a modifier.
VITE_BRAND_NAME=Docverse
VITE_BRAND_DOMAIN=example.com
VITE_HOSTING_COUNTRY=France
VITE_HOSTING_PROVIDER=OVHcloud
VITE_AI_PROVIDER=Mistral AI

# --- SEO ------------------------------------------------------------------
# Origine utilisee par le prerendu (scripts/prerender.mjs) pour les liens
# canoniques et le sitemap. Deduite de VITE_BRAND_DOMAIN si absente.
# SITE_ORIGIN=https://example.com
