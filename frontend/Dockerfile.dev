# Development image: runs the Next.js dev server with hot-reload so that
# editing files under ./frontend on the host is reflected immediately in
# the browser, without rebuilding the image or restarting the container.
FROM node:20-alpine
WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm install

COPY . .

ENV NEXT_TELEMETRY_DISABLED=1
# File changes are picked up reliably from a bind-mounted volume inside
# Docker (inotify events don't always propagate from the host filesystem,
# especially on macOS/Windows).
ENV WATCHPACK_POLLING=true

EXPOSE 3000
# node_modules lives in a named volume (docker-compose.yml) that outlives
# image rebuilds: re-sync it with package-lock.json before starting, so a
# dependency change never leaves the dev server on stale packages.
CMD ["sh", "-c", "npm install --no-audit --no-fund && npm run dev -- --hostname 0.0.0.0"]
