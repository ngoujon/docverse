# Development image: runs the Vite dev server with hot-reload so that
# editing files under ./frontend/src on the host is reflected immediately
# in the browser, without rebuilding the image or restarting the container.
FROM node:20-alpine
WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm install

COPY . .

EXPOSE 3000
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "3000"]
